# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local tool caches (never part of the Flutter project source).
.dotnet-cli/
.dotnet-home/
.gradle-local/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Android SDK and build properties (may contain API keys).
/android/local.properties

# Local environment files and signing credentials. Inject API keys and
# signing values at build time; never commit them to the Flutter project.
.env
.env.*
!.env.example
*.p12
*.pfx
*.pem
*.key
*.keystore
*.jks
